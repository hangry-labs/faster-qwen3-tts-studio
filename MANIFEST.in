include README.md LICENSE NOTICE THIRD_PARTY_NOTICES.md
include pyproject.toml Taskfile.yml Dockerfile .dockerignore requirements.runtime.txt
include .github/workflows/docker-build.yml
include .github/buildkitd.toml
recursive-include docs *.md
recursive-include src *.py *.toml *.html *.css *.js *.json LICENSE *.woff2 *.webp *.svg
recursive-include scripts *.py *.ps1
recursive-include tests *.py *.ps1
recursive-include benchmarks *.py
global-exclude *.pyc
global-exclude __pycache__/*
exclude *.wav
prune .venv
prune .ai
prune .idea
global-exclude AGENTS.md
