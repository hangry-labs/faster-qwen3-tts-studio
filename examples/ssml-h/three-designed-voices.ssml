<speak version="1.1" xmlns="http://www.w3.org/2001/10/synthesis"
       xmlns:h="https://hangrylabs.app/ns/ssml-h/1.0" xml:lang="en-US">
  <metadata><h:extensions version="1.0">
    <h:voice-definition name="Lena" scope="request" seed="7300">
      <h:description>A warm adult woman with a rich middle register, gentle breath, clear diction and an inviting storytelling rhythm.</h:description>
      <h:sample xml:lang="en-US">The little bookshop was quiet when I arrived. Outside, the rain had stopped, and warm sunlight was finding its way through the windows.</h:sample>
    </h:voice-definition>
    <h:voice-definition name="Orion" scope="request" seed="7301">
      <h:description>A calm adult man with a resonant baritone, unhurried phrasing and a reassuring, softly textured voice.</h:description>
      <h:sample xml:lang="en-US">The little bookshop was quiet when I arrived. Outside, the rain had stopped, and warm sunlight was finding its way through the windows.</h:sample>
    </h:voice-definition>
    <h:voice-definition name="Pip" scope="request" seed="7308">
      <h:description>A cheerful adult woman with a buoyant middle-high voice, playful intonation and upbeat but natural energy.</h:description>
      <h:sample xml:lang="en-US">The little bookshop was quiet when I arrived. Outside, the rain had stopped, and warm sunlight was finding its way through the windows.</h:sample>
    </h:voice-definition>
  </h:extensions></metadata>
  <voice name="Lena">The voice lab is ready. Have we checked the microphone?</voice>
  <break time="300ms"/>
  <voice name="Orion">Twice. Even the kettle has promised to stay quiet.</voice>
  <break time="300ms"/>
  <voice name="Pip">Perfect. Three different voices, and one very important cup of tea.</voice>
</speak>
