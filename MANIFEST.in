include README.md VERSION LICENSE NOTICE THIRD_PARTY_NOTICES.md
include README.nb.md README.pl.md README.ja.md README.zh.md README.es.md
include pyproject.toml Taskfile.yml Dockerfile .dockerignore requirements.runtime.txt
include requirements.runtime.in
include .github/workflows/docker-build.yml
include .github/buildkitd.toml
include docs/API.md docs/DEVELOPMENT.md docs/ENGINE.md docs/LICENSING.md
include docs/RELEASING.md docs/SSML-H.md docs/STUDIO.md
include docs/UPSTREAMS.md docs/UPSTREAM_BENCHMARKS.md docs/dockerhub.md
include docs/MCP.md
include docs/LIVE_API.md
recursive-include examples *.py
recursive-include src *.py *.toml *.html *.css *.js *.json LICENSE *.woff2 *.webp *.svg
recursive-include scripts *.py *.ps1
recursive-include tests *.py *.ps1
recursive-include tests/ui *.mjs
include site/theme/assets/hangry-pages/i18n.mjs
recursive-include benchmarks *.py
recursive-include benchmarks *.json *.md Dockerfile
recursive-include assets *.webp
prune benchmark-artifacts
global-exclude *.pyc
global-exclude __pycache__/*
exclude *.wav
prune .venv
prune .ai
prune docs/internal
prune .idea
global-exclude AGENTS.md
exclude UPSTREAM_PULL_REQUESTS.md UPSTREAM_ISSUES.md
